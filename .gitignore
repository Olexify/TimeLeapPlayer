# TimeLeapPlayer bake cache (settings live in %LOCALAPPDATA%, not here)
*.tlp
*.tlp.tmp*

# Shortcuts bake in an absolute path, so they are per-machine.
# `TimeLeap Player.lnk` is created locally, not shared.
*.lnk

